+static ssize_t h_readlinkat(int dirfd, const char *path, char *buf, size_t bufsiz) {
+    if (!g_inHook && g_cfg.loaded && path) {
+        HookGuard guard;
+        int saved_errno = errno;
+        char abs[PATH_MAX];
+        int fd = -1;
+        char ph[PATH_MAX];
+        if (resolveAt(dirfd, path, abs, sizeof(abs)) &&
+            parseProcFd(abs, &fd) && lookupBlob(fd, ph, sizeof(ph))) {
+            size_t len = strlen(ph);
+            size_t cp = len < bufsiz ? len : bufsiz;
+            if (cp > 0 && buf) memcpy(buf, ph, cp);
+            g_guards++;
+            errno = saved_errno;
+            return (ssize_t) cp;
+        }
+        errno = saved_errno;
+    }
