+
+static void hook(const char *name, void *target, void *repl, void **orig) {
+    if (!target) {
+        LOGI("hook %s: not found", name);
+        return;
+    }
+    void *tramp = nullptr;
+    int r = DobbyHook(target, repl, &tramp);
+    if (r == 0) {
+        *orig = tramp;
+        LOGI("hook %s: OK", name);
+    } else {
+        LOGI("hook %s: FAIL r=%d", name, r);
+        g_errors++;
+    }
+}
+
+void installHooks() {
+    void *h = dlopen("libc.so", RTLD_NOW);
+    orig_open = (int (*)(const char *, int, ...)) dlsym(h, "open");
+    orig_openat = (int (*)(int, const char *, int, ...)) dlsym(h, "openat");
+    orig_fchmod = (int (*)(int, mode_t)) dlsym(h, "fchmod");
+    orig_chmod = (int (*)(const char *, mode_t)) dlsym(h, "chmod");
+    orig_fchmodat = (int (*)(int, const char *, mode_t, int)) dlsym(h, "fchmodat");
+    orig_truncate = (int (*)(const char *, off_t)) dlsym(h, "truncate");
+    orig_utimensat = (int (*)(int, const char *, const struct timespec[2], int)) dlsym(h, "utimensat");
+    orig_setxattr = (int (*)(const char *, const char *, const void *, size_t, int)) dlsym(h, "setxattr");
+    orig_lsetxattr = (int (*)(const char *, const char *, const void *, size_t, int)) dlsym(h, "lsetxattr");
+    orig_fsetxattr = (int (*)(int, const char *, const void *, size_t, int)) dlsym(h, "fsetxattr");
+    orig_removexattr = (int (*)(const char *, const char *)) dlsym(h, "removexattr");
+    orig_lremovexattr = (int (*)(const char *, const char *)) dlsym(h, "lremovexattr");
+    orig_fremovexattr = (int (*)(int, const char *)) dlsym(h, "fremovexattr");
+    orig_readlinkat = (ssize_t (*)(int, const char *, char *, size_t)) dlsym(h, "readlinkat");
+
+    void *xh = xdl_open("libc.so", XDL_DEFAULT);
+    void *sym = xh ? xdl_dsym(xh, "__openat", nullptr) : nullptr;
+
+    hook("open", (void *) orig_open, (void *) h_open, (void **) &orig_open);
+    hook("openat", (void *) orig_openat, (void *) h_openat, (void **) &orig_openat);
+    hook("__openat", sym, (void *) h___openat, (void **) &orig___openat);
+    hook("fchmod", (void *) orig_fchmod, (void *) h_fchmod, (void **) &orig_fchmod);
+    hook("chmod", (void *) orig_chmod, (void *) h_chmod, (void **) &orig_chmod);
+    hook("fchmodat", (void *) orig_fchmodat, (void *) h_fchmodat, (void **) &orig_fchmodat);
+    hook("truncate", (void *) orig_truncate, (void *) h_truncate, (void **) &orig_truncate);
+    hook("utimensat", (void *) orig_utimensat, (void *) h_utimensat, (void **) &orig_utimensat);
+    hook("setxattr", (void *) orig_setxattr, (void *) h_setxattr, (void **) &orig_setxattr);
+    hook("lsetxattr", (void *) orig_lsetxattr, (void *) h_lsetxattr, (void **) &orig_lsetxattr);
+    hook("fsetxattr", (void *) orig_fsetxattr, (void *) h_fsetxattr, (void **) &orig_fsetxattr);
+    hook("removexattr", (void *) orig_removexattr, (void *) h_removexattr, (void **) &orig_removexattr);
+    hook("lremovexattr", (void *) orig_lremovexattr, (void *) h_lremovexattr, (void **) &orig_lremovexattr);
+    hook("fremovexattr", (void *) orig_fremovexattr, (void *) h_fremovexattr, (void **) &orig_fremovexattr);
+    hook("readlinkat", (void *) orig_readlinkat, (void *) h_readlinkat, (void **) &orig_readlinkat);
+}
