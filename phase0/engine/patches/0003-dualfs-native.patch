index 0000000..df8c347
--- /dev/null
+++ b/Bcore/src/main/cpp/dualfs/DualFs.h
@@ -0,0 +1,45 @@
+#ifndef DUALFS_H
+#define DUALFS_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <sys/types.h>
+#include <atomic>
+
+namespace dualfs {
+
+struct Config {
+    char pool[512];
+    char root[512];
+    char roots[4][512];
+    int nroots;
+    char tmp[512];
+    char tmp_int[512];
+    char locks[512];
+    char pkg[256];
+    int userId;
+    bool loaded;
+};
+
+extern Config g_cfg;
+extern std::atomic<long> g_opens;
+extern std::atomic<long> g_redirects;
+extern std::atomic<long> g_copyups;
+extern std::atomic<long> g_truncs;
+extern std::atomic<long> g_guards;
+extern std::atomic<long> g_errors;
+
+bool enable(const char *configPath);
+bool isPlaceholder(const char *path, char *blobPath, size_t blobPathSize, off_t *size,
+                   bool followSymlinks = false, char *resolvedPath = nullptr, size_t resolvedSize = 0);
+bool copyUp(const char *path);
+bool removeTag(const char *path);
+int realOpen(const char *path, int flags, mode_t mode);
+int realRemovexattr(const char *path, const char *name);
+ssize_t realReadlinkAt(int dirfd, const char *path, char *buf, size_t bufsiz);
+void installHooks();
+void logStats();
+
+}  // namespace dualfs
+
+#endif
diff --git a/Bcore/src/main/cpp/dualfs/HookBackend.cpp b/Bcore/src/main/cpp/dualfs/HookBackend.cpp
new file mode 100644
index 0000000..22d096b
--- /dev/null
+++ b/Bcore/src/main/cpp/dualfs/HookBackend.cpp
@@ -0,0 +1,639 @@
+// DualFs: libc hooks. Patch 0003 (new files).
+#include "DualFs.h"
+#include <android/log.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <dlfcn.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <limits.h>
+#include <pthread.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/xattr.h>
+#include "Dobby/dobby.h"
+#include "xdl.h"
+
+#define TAG "DUALFS"
+#define LOGI(...) __android_log_print(ANDROID_LOG_INFO, TAG, __VA_ARGS__)
+
+namespace dualfs {
+
+static int (*orig_open)(const char *, int, ...) = nullptr;
+static int (*orig_openat)(int, const char *, int, ...) = nullptr;
+static int (*orig___openat)(int, const char *, int, int) = nullptr;
+static int (*orig_fchmod)(int, mode_t) = nullptr;
+static int (*orig_chmod)(const char *, mode_t) = nullptr;
+static int (*orig_fchmodat)(int, const char *, mode_t, int) = nullptr;
+static int (*orig_truncate)(const char *, off_t) = nullptr;
+static int (*orig_utimensat)(int, const char *, const struct timespec[2], int) = nullptr;
+static int (*orig_setxattr)(const char *, const char *, const void *, size_t, int) = nullptr;
+static int (*orig_lsetxattr)(const char *, const char *, const void *, size_t, int) = nullptr;
+static int (*orig_fsetxattr)(int, const char *, const void *, size_t, int) = nullptr;
+static int (*orig_removexattr)(const char *, const char *) = nullptr;
+static int (*orig_lremovexattr)(const char *, const char *) = nullptr;
+static int (*orig_fremovexattr)(int, const char *) = nullptr;
+static ssize_t (*orig_readlinkat)(int, const char *, char *, size_t) = nullptr;
+
+static thread_local bool g_inHook = false;
+
+struct HookGuard {
+    bool prev;
+    HookGuard() : prev(g_inHook) { g_inHook = true; }
+    ~HookGuard() { g_inHook = prev; }
+};
+
+int realOpen(const char *path, int flags, mode_t mode) {
+    if (orig___openat) return orig___openat(AT_FDCWD, path, flags, (int) mode);
+    return (int) syscall(SYS_openat, AT_FDCWD, path, flags, (int) mode);
+}
+
+static int realOpenAt(int dirfd, const char *path, int flags, mode_t mode) {
+    if (orig___openat) return orig___openat(dirfd, path, flags, (int) mode);
+    return (int) syscall(SYS_openat, dirfd, path, flags, (int) mode);
+}
+
+static int realFchmod(int fd, mode_t mode) {
+    if (orig_fchmod) return orig_fchmod(fd, mode);
+    return (int) syscall(SYS_fchmod, fd, mode);
+}
+
+static int realChmod(const char *path, mode_t mode) {
+    return (int) syscall(SYS_fchmodat, AT_FDCWD, path, mode, 0);
+}
+
+static int realFchmodat(int dirfd, const char *path, mode_t mode, int flags) {
+    if (orig_fchmodat) return orig_fchmodat(dirfd, path, mode, flags);
+    return (int) syscall(SYS_fchmodat, dirfd, path, mode, flags);
+}
+
+static int realTruncate(const char *path, off_t len) {
+    if (orig_truncate) return orig_truncate(path, len);
+    return (int) syscall(SYS_truncate, path, len);
+}
+
+static int realUtimensat(int dirfd, const char *path, const struct timespec times[2], int flags) {
+    if (orig_utimensat) return orig_utimensat(dirfd, path, times, flags);
+    return (int) syscall(SYS_utimensat, dirfd, path, times, flags);
+}
+
+static int realSetxattr(const char *path, const char *name, const void *value, size_t size, int flags) {
+    if (orig_setxattr) return orig_setxattr(path, name, value, size, flags);
+    return (int) syscall(SYS_setxattr, path, name, value, size, flags);
+}
+
+static int realLsetxattr(const char *path, const char *name, const void *value, size_t size, int flags) {
+    if (orig_lsetxattr) return orig_lsetxattr(path, name, value, size, flags);
+    return (int) syscall(SYS_lsetxattr, path, name, value, size, flags);
+}
+
+static int realFsetxattr(int fd, const char *name, const void *value, size_t size, int flags) {
+    if (orig_fsetxattr) return orig_fsetxattr(fd, name, value, size, flags);
+    return (int) syscall(SYS_fsetxattr, fd, name, value, size, flags);
+}
+
+int realRemovexattr(const char *path, const char *name) {
+    if (orig_removexattr) return orig_removexattr(path, name);
+    return (int) syscall(SYS_removexattr, path, name);
+}
+
+static int realLremovexattr(const char *path, const char *name) {
+    if (orig_lremovexattr) return orig_lremovexattr(path, name);
+    return (int) syscall(SYS_lremovexattr, path, name);
+}
+
+static int realFremovexattr(int fd, const char *name) {
+    if (orig_fremovexattr) return orig_fremovexattr(fd, name);
+    return (int) syscall(SYS_fremovexattr, fd, name);
+}
+
+ssize_t realReadlinkAt(int dirfd, const char *path, char *buf, size_t bufsiz) {
+    if (orig_readlinkat) return orig_readlinkat(dirfd, path, buf, bufsiz);
+    return (ssize_t) syscall(SYS_readlinkat, dirfd, path, buf, bufsiz);
+}
+
+struct BlobEntry {
+    int fd;
+    char blob[PATH_MAX];
+    char ph[PATH_MAX];
+};
+
+static constexpr int kMaxBlobs = 1024;
+static BlobEntry g_blobs[kMaxBlobs];
+static pthread_mutex_t g_blobLock = PTHREAD_MUTEX_INITIALIZER;
+
+static void recordBlob(int fd, const char *blob, const char *ph) {
+    pthread_mutex_lock(&g_blobLock);
+    int freeIdx = -1;
+    int matchIdx = -1;
+    for (int i = 0; i < kMaxBlobs; i++) {
+        if (g_blobs[i].fd == fd) {
+            matchIdx = i;
+            break;
+        }
+        if (freeIdx < 0 && g_blobs[i].fd == 0) {
+            freeIdx = i;
+        }
+    }
+    int idx = (matchIdx >= 0) ? matchIdx : (freeIdx >= 0 ? freeIdx : ((unsigned) fd % kMaxBlobs));
+    g_blobs[idx].fd = fd;
+    snprintf(g_blobs[idx].blob, sizeof(g_blobs[idx].blob), "%s", blob);
+    snprintf(g_blobs[idx].ph, sizeof(g_blobs[idx].ph), "%s", ph);
+    pthread_mutex_unlock(&g_blobLock);
+}
+
+static bool readFdTarget(int fd, char *target, size_t n) {
+    if (fd < 0) return false;
+    char proc[64];
+    snprintf(proc, sizeof(proc), "/proc/self/fd/%d", fd);
+    ssize_t len = realReadlinkAt(AT_FDCWD, proc, target, n - 1);
+    if (len <= 0) return false;
+    target[len] = 0;
+    return true;
+}
+
+static bool lookupBlob(int fd, char *phOut, size_t n) {
+    char target[PATH_MAX];
+    if (!readFdTarget(fd, target, sizeof(target))) return false;
+    bool found = false;
+    pthread_mutex_lock(&g_blobLock);
+    for (int i = 0; i < kMaxBlobs; i++) {
+        if (g_blobs[i].fd == fd && !strcmp(g_blobs[i].blob, target)) {
+            snprintf(phOut, n, "%s", g_blobs[i].ph);
+            found = true;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&g_blobLock);
+    return found;
+}
+
+static bool isPoolFd(int fd) {
+    char target[PATH_MAX];
+    if (!readFdTarget(fd, target, sizeof(target))) return false;
+    size_t plen = strlen(g_cfg.pool);
+    return plen > 0 && strncmp(target, g_cfg.pool, plen) == 0 && target[plen] == '/';
+}
+
+static bool parseProcFd(const char *path, int *fdOut) {
+    if (!path) return false;
+    const char *p = nullptr;
+    if (strncmp(path, "/proc/self/fd/", 14) == 0) {
+        p = path + 14;
+    } else if (strncmp(path, "/proc/", 6) == 0) {
+        char prefix[64];
+        int plen = snprintf(prefix, sizeof(prefix), "/proc/%d/fd/", (int) getpid());
+        if (plen > 0 && strncmp(path, prefix, (size_t) plen) == 0) {
+            p = path + plen;
+        }
+    }
+    if (!p || *p < '0' || *p > '9') return false;
+    char *end = nullptr;
+    long val = strtol(p, &end, 10);
+    if (!end || *end != '\0' || val < 0 || val > 1048576) return false;
+    *fdOut = (int) val;
+    return true;
+}
+
+static bool resolveAt(int dirfd, const char *path, char *out, size_t outSize) {
+    if (!path || !path[0]) return false;
+    if (path[0] == '/') {
+        snprintf(out, outSize, "%s", path);
+        return true;
+    }
+    char dir[PATH_MAX];
+    if (dirfd == AT_FDCWD) {
+        if (!getcwd(dir, sizeof(dir))) return false;
+    } else {
+        if (!readFdTarget(dirfd, dir, sizeof(dir))) return false;
+    }
+    const char *rel = (path[0] == '.' && path[1] == '/') ? (path + 2) : path;
+    if (!rel[0] || !strcmp(rel, ".")) {
+        snprintf(out, outSize, "%s", dir);
+    } else {
+        snprintf(out, outSize, "%s/%s", dir, rel);
+    }
+    return true;
+}
+
+static bool isProtectedXattr(const char *name) {
+    return name && strncmp(name, "user.dualapp.", 13) == 0;
+}
+
+static int do_open(const char *path, int flags, mode_t mode, int dirfd, bool is_at) {
+    if (!path || g_inHook || !g_cfg.loaded) {
+        return is_at ? realOpenAt(dirfd, path, flags, mode)
+                     : realOpen(path, flags, mode);
+    }
+    HookGuard guard;
+    int saved_errno = errno;
+    char absBuf[PATH_MAX];
+    const char *targetPath = path;
+    if (resolveAt(dirfd, path, absBuf, sizeof(absBuf))) {
+        targetPath = absBuf;
+    }
+
+    int pfd = -1;
+    char phBuf[PATH_MAX];
+    if (parseProcFd(targetPath, &pfd)) {
+        if (lookupBlob(pfd, phBuf, sizeof(phBuf))) {
+            targetPath = phBuf;
+            dirfd = AT_FDCWD;
+            is_at = false;
+        } else if (isPoolFd(pfd)) {
+            int acc = flags & O_ACCMODE;
+            bool write = (acc == O_WRONLY || acc == O_RDWR) || (flags & (O_APPEND | O_TRUNC));
+            if (write) {
+                g_guards++;
+                errno = EACCES;
+                return -1;
+            }
+        }
+    }
+
+    char blob[PATH_MAX];
+    char resolved[PATH_MAX];
+    off_t size;
+    bool follow = !(flags & O_NOFOLLOW);
+    if (isPlaceholder(targetPath, blob, sizeof(blob), &size, follow, resolved, sizeof(resolved))) {
+        g_opens++;
+        if ((flags & (O_CREAT | O_EXCL)) == (O_CREAT | O_EXCL)) {
+            errno = saved_errno;
+            return is_at ? realOpenAt(dirfd, targetPath, flags, mode)
+                         : realOpen(targetPath, flags, mode);
+        }
+        int acc = flags & O_ACCMODE;
+        bool write = (acc == O_WRONLY || acc == O_RDWR) || (flags & O_APPEND);
+        if (flags & O_TRUNC) {
+            if (access(resolved, W_OK) == 0) {
+                removeTag(resolved);
+            }
+            errno = saved_errno;
+            int fd = realOpen(resolved, flags, mode);
+            if (fd >= 0) removeTag(resolved);
+            g_truncs++;
+            return fd;
+        }
+        if (!write) {
+            errno = saved_errno;
+            int fd = realOpen(blob, O_RDONLY | (flags & O_CLOEXEC), 0);
+            if (fd >= 0) {
+                recordBlob(fd, blob, resolved);
+                g_redirects++;
+            }
+            return fd;
+        }
+        if (!copyUp(resolved)) {
+            errno = EIO;
+            g_errors++;
+            return -1;
+        }
+        errno = saved_errno;
+        return realOpen(resolved, flags, mode);
+    }
+
+    errno = saved_errno;
+    return is_at ? realOpenAt(dirfd, path, flags, mode)
+                 : realOpen(path, flags, mode);
+}
+
+static int h_open(const char *path, int flags, ...) {
+    mode_t mode = 0;
+    if (flags & O_CREAT) {
+        va_list ap;
+        va_start(ap, flags);
+        mode = va_arg(ap, mode_t);
+        va_end(ap);
+    }
+    return do_open(path, flags, mode, AT_FDCWD, false);
+}
