diff --git a/Bcore/src/main/cpp/dualfs/CopyUp.cpp b/Bcore/src/main/cpp/dualfs/CopyUp.cpp
new file mode 100644
index 0000000..a347304
--- /dev/null
+++ b/Bcore/src/main/cpp/dualfs/CopyUp.cpp
@@ -0,0 +1,122 @@
+// DualFs: copy-up. Patch 0003 (new files).
+#include "DualFs.h"
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <sys/file.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#include <limits.h>
+
+namespace dualfs {
+
+static bool copyAll(int sfd, int dfd, off_t size) {
+    off_t off = 0;
+    bool ok = true;
+    while (off < size) {
+#ifdef __NR_copy_file_range
+        long n = syscall(__NR_copy_file_range, sfd, &off, dfd, nullptr,
+                         (size_t) (size - off), 0);
+#else
+        long n = -1;
+#endif
+        if (n <= 0) { ok = false; break; }
+    }
+    if (ok) return true;
+
+    // Fallback: 1 MiB read/write.
+    off = 0;
+    lseek(sfd, 0, SEEK_SET);
+    lseek(dfd, 0, SEEK_SET);
+    char buf[1 << 20];
+    while (off < size) {
+        ssize_t n = read(sfd, buf, sizeof(buf));
+        if (n <= 0) return false;
+        ssize_t w = 0;
+        while (w < n) {
+            ssize_t k = write(dfd, buf + w, (size_t) (n - w));
+            if (k <= 0) return false;
+            w += k;
+        }
+        off += n;
+    }
+    return true;
+}
+
+bool copyUp(const char *path) {
+    char blob[PATH_MAX];
+    off_t size;
+    if (!isPlaceholder(path, blob, sizeof(blob), &size)) return false;
+
+    struct stat st;
+    if (lstat(path, &st) != 0) return false;
+
+    char lockPath[PATH_MAX];
+    snprintf(lockPath, sizeof(lockPath), "%s/%ld", g_cfg.locks, (long) (st.st_ino % 64));
+    int lfd = realOpen(lockPath, O_CREAT | O_RDWR | O_CLOEXEC, 0600);
+    if (lfd < 0) { g_errors++; return false; }
+    flock(lfd, LOCK_EX);
+
+    if (!isPlaceholder(path, blob, sizeof(blob), &size)) {
+        flock(lfd, LOCK_UN);
+        close(lfd);
+        return false;
+    }
+
+    char tmp[PATH_MAX];
+    snprintf(tmp, sizeof(tmp), "%s/cu-%lu-%d-%ld", g_cfg.tmp,
+             (unsigned long) st.st_ino, (int) getpid(), (long) time(nullptr));
+    int sfd = realOpen(blob, O_RDONLY | O_CLOEXEC, 0);
+    int dfd = realOpen(tmp, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, st.st_mode & 07777);
+    if (sfd < 0 || dfd < 0) {
+        if (sfd >= 0) close(sfd);
+        if (dfd >= 0) close(dfd);
+        unlink(tmp);
+        flock(lfd, LOCK_UN);
+        close(lfd);
+        g_errors++;
+        return false;
+    }
+
+    bool ok = copyAll(sfd, dfd, size);
+    if (ok) {
+        fsync(dfd);
+        struct timespec ts[2] = { st.st_atim, st.st_mtim };
+        futimens(dfd, ts);
+    }
+    close(sfd);
+    close(dfd);
+    if (!ok) {
+        unlink(tmp);
+        flock(lfd, LOCK_UN);
+        close(lfd);
+        g_errors++;
+        return false;
+    }
+
+    if (rename(tmp, path) != 0) {
+        unlink(tmp);
+        flock(lfd, LOCK_UN);
+        close(lfd);
+        g_errors++;
+        return false;
+    }
+
+    char dir[PATH_MAX];
+    snprintf(dir, sizeof(dir), "%s", path);
+    char *slash = strrchr(dir, '/');
+    if (slash) {
+        *slash = 0;
+        int df = realOpen(dir, O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0);
+        if (df >= 0) { fsync(df); close(df); }
+    }
+    flock(lfd, LOCK_UN);
+    close(lfd);
+    g_copyups++;
+    return true;
+}
+
+}  // namespace dualfs
diff --git a/Bcore/src/main/cpp/dualfs/DualFs.cpp b/Bcore/src/main/cpp/dualfs/DualFs.cpp
new file mode 100644
index 0000000..41fb378
--- /dev/null
+++ b/Bcore/src/main/cpp/dualfs/DualFs.cpp
@@ -0,0 +1,82 @@
+// DualFs: config, counters and start-up. Patch 0003 (new files).
+#include "DualFs.h"
+#include <android/log.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <dirent.h>
+#include <sys/stat.h>
+
+#define TAG "DUALFS"
+#define LOGI(...) __android_log_print(ANDROID_LOG_INFO, TAG, __VA_ARGS__)
+
+namespace dualfs {
+
+Config g_cfg = {};
+std::atomic<long> g_opens(0), g_redirects(0), g_copyups(0), g_truncs(0), g_guards(0), g_errors(0);
+
+static char *trim(char *s) {
+    while (*s == ' ' || *s == '\t' || *s == '\r' || *s == '\n') s++;
+    char *e = s + strlen(s);
+    while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\n')) *--e = 0;
+    return s;
+}
+
+static bool parseConfig(const char *path) {
+    FILE *f = fopen(path, "r");
+    if (!f) return false;
+    char line[1024];
+    while (fgets(line, sizeof(line), f)) {
+        char *eq = strchr(line, '=');
+        if (!eq) continue;
+        *eq = 0;
+        char *k = trim(line);
+        char *v = trim(eq + 1);
+        if (!strcmp(k, "pool")) snprintf(g_cfg.pool, sizeof(g_cfg.pool), "%s", v);
+        else if (!strcmp(k, "root")) snprintf(g_cfg.root, sizeof(g_cfg.root), "%s", v);
+        else if (!strcmp(k, "tmp")) snprintf(g_cfg.tmp, sizeof(g_cfg.tmp), "%s", v);
+        else if (!strcmp(k, "locks")) snprintf(g_cfg.locks, sizeof(g_cfg.locks), "%s", v);
+        else if (!strcmp(k, "pkg")) snprintf(g_cfg.pkg, sizeof(g_cfg.pkg), "%s", v);
+        else if (!strcmp(k, "user")) g_cfg.userId = atoi(v);
+    }
+    fclose(f);
+    return g_cfg.pool[0] && g_cfg.root[0] && g_cfg.tmp[0] && g_cfg.locks[0];
+}
+
+static void cleanTmp() {
+    DIR *d = opendir(g_cfg.tmp);
+    if (!d) return;
+    struct dirent *e;
+    int n = 0;
+    while ((e = readdir(d)) != nullptr) {
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+        char p[1024];
+        snprintf(p, sizeof(p), "%s/%s", g_cfg.tmp, e->d_name);
+        if (unlink(p) == 0) n++;
+    }
+    closedir(d);
+    if (n) LOGI("cleaned %d orphan(s) from tmp", n);
+}
+
+bool enable(const char *configPath) {
+    if (g_cfg.loaded) return true;
+    if (!parseConfig(configPath)) {
+        LOGI("config parse failed: %s", configPath);
+        return false;
+    }
+    cleanTmp();
+    installHooks();
+    g_cfg.loaded = true;
+    LOGI("enabled: pkg=%s user=%d pool=%s root=%s", g_cfg.pkg, g_cfg.userId, g_cfg.pool, g_cfg.root);
+    return true;
+}
+
+void logStats() {
+    LOGI("stats opens=%ld redirects=%ld copyups=%ld truncs=%ld guards=%ld errors=%ld",
+         g_opens.load(), g_redirects.load(), g_copyups.load(), g_truncs.load(),
+         g_guards.load(), g_errors.load());
+}
+
+}  // namespace dualfs
diff --git a/Bcore/src/main/cpp/dualfs/DualFs.h b/Bcore/src/main/cpp/dualfs/DualFs.h
new file mode 100644
index 0000000..7399d6c
