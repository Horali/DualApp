+// DualFs: placeholder tag and test. Patch 0003 (new files).
+#include "DualFs.h"
+#include <sys/xattr.h>
+#include <sys/stat.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <limits.h>
+
+namespace dualfs {
+
+static const char *kTag = "user.dualapp.blob";
+
+static bool underRoot(const char *path) {
+    for (int i = 0; i < g_cfg.nroots; i++) {
+        size_t n = strlen(g_cfg.roots[i]);
+        if (n > 0 && strncmp(path, g_cfg.roots[i], n) == 0 &&
+            (path[n] == '/' || path[n] == '\0')) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool readTag(const char *path, char *sha, size_t shaSize, off_t *size) {
+    char buf[256];
+    ssize_t n = getxattr(path, kTag, buf, sizeof(buf) - 1);
+    if (n <= 0) return false;
+    buf[n] = 0;
+    char *c = strchr(buf, ':');
+    if (!c) return false;
+    *c = 0;
+    snprintf(sha, shaSize, "%s", buf);
+    *size = strtoll(c + 1, nullptr, 10);
+    return *size >= 0;
+}
+
+bool isPlaceholder(const char *path, char *blobPath, size_t blobPathSize, off_t *size,
+                   bool followSymlinks, char *resolvedPath, size_t resolvedSize) {
+    if (!g_cfg.loaded || !path) return false;
+    struct stat st;
+    if (lstat(path, &st) != 0) return false;
+    const char *usePath = path;
+    char linkBuf[PATH_MAX];
+    if (S_ISLNK(st.st_mode)) {
+        if (!followSymlinks) return false;
+        if (!realpath(path, linkBuf)) return false;
+        usePath = linkBuf;
+        if (lstat(usePath, &st) != 0) return false;
+    }
+    if (!underRoot(usePath)) return false;
+    if (!S_ISREG(st.st_mode)) return false;
+    // The xattr tag costs at most one 4 KiB block (st_blocks <= 8); any data write allocates >= 16.
+    if (st.st_size > 0 && st.st_blocks > 8) return false;
+    char sha[80];
+    off_t tagSize;
+    if (!readTag(usePath, sha, sizeof(sha), &tagSize)) return false;
+    if (strlen(sha) != 64 || tagSize != st.st_size) return false;
+    snprintf(blobPath, blobPathSize, "%s/blobs/%c%c/%s", g_cfg.pool, sha[0], sha[1], sha);
+    *size = st.st_size;
+    if (resolvedPath && resolvedSize > 0) snprintf(resolvedPath, resolvedSize, "%s", usePath);
+    return true;
+}
+
+bool removeTag(const char *path) {
+    return realRemovexattr(path, kTag) == 0;
+}
+
+}  // namespace dualfs
