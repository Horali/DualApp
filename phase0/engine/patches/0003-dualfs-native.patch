+                g_guards++;
+                errno = saved_errno;
+                return realUtimensat(AT_FDCWD, ph, times, 0);
+            }
+        } else {
+            char abs[PATH_MAX];
+            int fd = -1;
+            if (resolveAt(dirfd, path, abs, sizeof(abs)) &&
+                parseProcFd(abs, &fd) && lookupBlob(fd, ph, sizeof(ph))) {
