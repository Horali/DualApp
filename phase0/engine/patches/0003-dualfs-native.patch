+static int h_truncate(const char *path, off_t len) {
+    if (!g_inHook && g_cfg.loaded && path) {
+        HookGuard guard;
+        int saved_errno = errno;
+        const char *targetPath = path;
+        char ph[PATH_MAX];
+        int pfd = -1;
+        if (parseProcFd(path, &pfd) && lookupBlob(pfd, ph, sizeof(ph))) {
+            targetPath = ph;
+        }
+        char blob[PATH_MAX];
+        char resolved[PATH_MAX];
+        off_t size;
+        if (isPlaceholder(targetPath, blob, sizeof(blob), &size, true, resolved, sizeof(resolved))) {
+            if (len == 0) {
+                if (access(resolved, W_OK) == 0) {
+                    removeTag(resolved);
+                }
+                errno = saved_errno;
+                int r = realTruncate(resolved, 0);
+                if (r == 0) removeTag(resolved);
+                g_truncs++;
+                return r;
+            }
+            if (!copyUp(resolved)) {
+                errno = EIO;
+                g_errors++;
+                return -1;
+            }
+            errno = saved_errno;
+            return realTruncate(resolved, len);
+        }
+        errno = saved_errno;
+    }
+    return realTruncate(path, len);
+}
